# Cloudflare Pages headers

# Applied to every response. No CSP here on purpose — it can't be verified
# locally (`astro preview` ignores this file), and a wrong one fails closed as
# a blank page. Add it deliberately, allowing giscus.app, if comments go live.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Long-cache Astro's content-hashed assets; they never change once built.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not content-hashed, so they can't be immutable — but they change rarely.
/og.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/resume.pdf
  Cache-Control: public, max-age=86400
