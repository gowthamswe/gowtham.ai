---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE, ABOUT } from '../consts';
import timeline from '../data/timeline';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  {/* Same container as /blog and the post layout, so the whole site reads as
      one column at one measure. */}
  <div class="min-h-screen flex justify-center">
    <div class="w-full max-w-[760px] px-5 md:px-8 pt-[80px] pb-24">
      <header class="mb-12">
        <h1 class="text-[var(--fg-strong)] text-4xl font-bold">{SITE.title}</h1>
        <nav class="mt-4 flex gap-5 text-sm">
          <a href="/" class="text-white">Home</a>
          <a href="/blog" class="text-[var(--fg)] hover:text-white">Writing</a>
        </nav>
      </header>

      <section class="mb-14 text-[var(--fg)]">
        <h2 class="sr-only">About</h2>
        <p class="text-lg">{ABOUT}</p>
      </section>

      {
        posts.length > 0 && (
          <section class="mb-14 text-[var(--fg)]">
            <div class="flex items-baseline justify-between mb-4">
              <h2 class="text-xl font-bold">Writing</h2>
              <a href="/blog" class="text-sm underline hover:text-white inline-flex items-center gap-1">
                All posts <Icon name="arrow-right" size={14} />
              </a>
            </div>
            <div class="flex flex-col gap-4">
              {posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="block card hover:no-underline">
                  <span class="block font-bold text-[var(--fg-strong)]">{post.data.title}</span>
                  <span class="block text-sm text-[var(--fg-muted)] mt-1">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  <span class="block mt-2">{post.data.description}</span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <section class="mb-14 text-[var(--fg)]">
        <h2 class="text-xl font-bold mb-4">Projects</h2>
        <div class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <div class="card">
                <span class="block font-bold">
                  {project.name} <span class="ml-2">({project.year})</span>
                </span>
                <span class="block mt-2">{project.description}</span>
                <div class="flex flex-wrap mt-2 items-center">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ml-2 text-sm underline hover:text-white"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="mb-14 text-[var(--fg)]">
        <h2 class="text-xl font-bold mb-4">Timeline</h2>
        <div class="flex flex-col gap-4">
          {
            timeline.map((entry) => (
              <div class="card">
                <span class="block font-bold">
                  {entry.title} <span class="ml-2">({entry.year})</span>
                </span>
                {entry.description && <span class="block mt-2">{entry.description}</span>}
                {entry.tags && entry.tags.length > 0 && (
                  <div class="flex flex-wrap mt-2">
                    {entry.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <footer
        class="mt-16 pt-8 border-t border-[var(--border)] flex items-center justify-between gap-4"
      >
        <SocialLinks />
        <a
          href="/blog"
          class="text-sm text-[var(--fg)] underline hover:text-white inline-flex items-center gap-1"
        >
          Writing <Icon name="arrow-right" size={14} />
        </a>
      </footer>
    </div>
  </div>
</BaseLayout>
